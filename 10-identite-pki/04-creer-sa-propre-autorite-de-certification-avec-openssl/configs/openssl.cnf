# Autorité de certification du lab — configuration OpenSSL 3.5
# Utilisée pour créer la racine, signer les certificats serveur et publier la CRL.

[ ca ]
default_ca = CA_default

[ CA_default ]
dir             = /root/pki
database        = $dir/index.txt
new_certs_dir   = $dir/newcerts
certificate     = $dir/ca.crt
serial          = $dir/serial
crlnumber       = $dir/crlnumber
private_key     = $dir/ca.key
default_md      = sha256
default_days    = 825
default_crl_days = 3650
policy          = politique_lab
unique_subject  = no
copy_extensions = none

[ politique_lab ]
countryName            = optional
stateOrProvinceName    = optional
organizationName       = optional
organizationalUnitName = optional
commonName             = supplied
emailAddress           = optional

[ req ]
default_bits       = 2048
distinguished_name = dn_serveur
prompt             = no

[ dn_serveur ]
C  = FR
O  = Lab sysadmin-lab
CN = srv-debian13.lab.local

# Racine : peut signer des certificats et des CRL, rien d'autre.
[ v3_ca ]
basicConstraints       = critical, CA:TRUE, pathlen:0
keyUsage               = critical, keyCertSign, cRLSign
subjectKeyIdentifier   = hash

# Certificat serveur : usage TLS uniquement, avec les noms réellement servis.
[ server_cert ]
basicConstraints       = critical, CA:FALSE
keyUsage               = critical, digitalSignature, keyEncipherment
extendedKeyUsage       = serverAuth
subjectAltName         = @alt_names
authorityKeyIdentifier = keyid, issuer

[ alt_names ]
DNS.1 = srv-debian13.lab.local
DNS.2 = www.lab.local
IP.1  = 10.0.3.10
